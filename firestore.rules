rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['id', 'name', 'ingredients', 'instructions', 'userId']) &&
             data.id is int &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.ingredients is string && data.ingredients.size() <= 2000 &&
             data.instructions is string && data.instructions.size() <= 5000 &&
             data.userId is string && data.userId == request.auth.uid;
    }

    // Rules for recipes collection
    match /recipes/{recipeId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(recipeId) && isValidRecipe(request.resource.data);
      allow update: if isSignedIn() && isValidId(recipeId) && isValidRecipe(request.resource.data) &&
                      request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
